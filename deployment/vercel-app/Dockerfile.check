# Local validation only; this is not a Docker/OCI deployment on Vercel.
FROM python:3.13.7-slim
ENV PYTHONDONTWRITEBYTECODE=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
WORKDIR /app
COPY requirements.txt constraints-linux.txt pyproject.toml uv.lock .python-version ./
RUN python -m pip install --no-cache-dir uv==0.13.9 && uv pip install --system -r requirements.txt && uv pip check --system
COPY . .
CMD ["python", "verify_runtime.py", "--require-linux", "--output", "/results/linux-runtime.json"]
